import pandas as pd
data = {
    "Name": ["Anu", "Bala", "Cathy", "David"],
    "Marks": [85, None, 78, 90]
}
df = pd.DataFrame(data)
print("Original Dataset:")
print(df)
print("\nMissing Values:")
print(df.isnull())
# Replace missing value with mean
df["Marks"] = df["Marks"].fillna(df["Marks"].mean())

print("\nAfter Handling Missing Value:")
print(df)
